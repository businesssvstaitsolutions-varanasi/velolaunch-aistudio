{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/our-apps/(.*)",
      "destination": "/our-apps/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
